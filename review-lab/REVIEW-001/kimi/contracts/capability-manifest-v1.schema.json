{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mission-platform/contracts/capability-manifest-v1.schema.json",
  "title": "Mission Platform Capability Manifest v1 (SemVer: control-plane 1.x)",
  "type": "object",
  "required": ["schema", "payload_id", "version", "capabilities", "resource_quota", "data_classification", "health"],
  "properties": {
    "schema": {"const": "mission.capability-manifest.v1"},
    "payload_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "version": {"type": "string", "description": "SemVer of the payload package"},
    "payload_api": {"type": "string", "description": "SemVer range of the payload-facing contract the driver implements"},
    "capabilities": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.]*$"},
      "description": "DECLARED needs only. The platform validates fail-closed against its signed allowlist; a payload never grants itself privileges."
    },
    "resource_quota": {
      "type": "object",
      "properties": {
        "cpu_seconds": {"type": "integer", "minimum": 1},
        "rss_mb": {"type": "integer", "minimum": 16},
        "disk_mb": {"type": "integer", "minimum": 0},
        "egress_mbit_day": {"type": "integer", "minimum": 0}
      },
      "required": ["cpu_seconds", "rss_mb"]
    },
    "filesystem_allowlist": {"type": "array", "items": {"type": "string"}},
    "network_allowlist": {"type": "array", "items": {"type": "string"}, "description": "Outbound destinations only. Payloads open no inbound ports."},
    "service_identity": {"type": "string", "description": "Payload's own credential identity; never the platform credential."},
    "data_classification": {"enum": ["image", "process", "telemetry"], "description": "Drives retention/DPIA per payload (GDPR)."},
    "health": {
      "type": "object",
      "required": ["restart"],
      "properties": {
        "restart": {"enum": ["never", "on-failure", "always"]},
        "max_restarts": {"type": "integer", "minimum": 0},
        "degraded_mode": {"type": "string"},
        "rollback": {"type": "string", "description": "Signed package version to roll back to on failure."}
      }
    },
    "signature": {"type": "string", "description": "Detached signature over the manifest body (PoC: HMAC-SHA256; production: Ed25519, see ADR-K003)."}
  },
  "additionalProperties": false
}
